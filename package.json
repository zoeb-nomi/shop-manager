{
  "name": "shop-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "web": "TELEGRAM_BOT_TOKEN= node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "seed-demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "grammy": "^1.46.0",
    "hono": "^4.13.20",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
